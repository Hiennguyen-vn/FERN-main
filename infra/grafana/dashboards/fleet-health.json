{
  "title": "POS Fleet Health",
  "uid": "fern-fleet-health",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["fern", "pos", "fleet"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Outbox depth (per device)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "client_outbox_depth", "legendFormat": "{{device_id}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Outbox depth p95 across fleet",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(client_outbox_depth[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Sync latency rate (per device, ms/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(client_sync_latency_total[5m])", "legendFormat": "{{device_id}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Failed events rate (per device)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(client_failed_events_total[5m])", "legendFormat": "{{device_id}}" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Devices reporting (last 5m)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(count by (device_id) (client_outbox_depth))" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "SW activations (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(client_sw_activations_total[1h]))" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dexie storage usage ratio (per outlet)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "dexie_storage_usage_ratio", "legendFormat": "outlet {{outlet_id}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.85 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Clock skew (per outlet, seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "client_clock_skew_seconds", "legendFormat": "outlet {{outlet_id}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
