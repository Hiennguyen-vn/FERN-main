POSTGRES_DB=fern
POSTGRES_USER=fern
POSTGRES_PASSWORD=fern
POSTGRES_APP_USER=fern_app
POSTGRES_APP_PASSWORD=fern_app
POSTGRES_REPLICATION_USER=repl_user
POSTGRES_REPLICATION_PASSWORD=repl_pass
POSTGRES_REPLICATION_SLOT=fern_replica_slot
POSTGRES_REPLICA_FORCE_RESEED=false
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433
POSTGRES_SCHEMA=core
REDIS_PORT=6379
KAFKA_PORT=9092
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
MASTER_NODE_PORT=8082
ORG_SERVICE_PORT=8083
HR_SERVICE_PORT=8084
PRODUCT_SERVICE_PORT=8085
PROCUREMENT_SERVICE_PORT=8086
SALES_SERVICE_PORT=8087
INVENTORY_SERVICE_PORT=8088
PAYROLL_SERVICE_PORT=8089
FINANCE_SERVICE_PORT=8090
AUDIT_SERVICE_PORT=8091
REPORT_SERVICE_PORT=8092
AI_QUERY_SERVICE_PORT=8093
INTERNAL_SERVICE_TOKEN=__GENERATE_INTERNAL_SERVICE_TOKEN__
JWT_SECRET=__GENERATE_JWT_SECRET__
AUTH_COOKIE_NAME=dorabets_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
WORKER_ID=1
TEST_WAIT_SECONDS=90

# AI query LLM provider. Leave OPENAI_BASE_URL empty for OpenAI's default endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_MODE=chat
OPENAI_USER_AGENT=FERN-ai-query-service/0.1
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDINGS_ENABLED=true

# S3-compatible object storage for catalog product images.
# Set S3_CONSOLE_ENDPOINT when the S3 API endpoint is not reachable from the app
# but MinIO Console can upload/download objects.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_PRODUCT_IMAGES=
S3_ENDPOINT=
S3_CONSOLE_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_PATH_STYLE=true

# OpenTelemetry / Jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
OTEL_SAMPLE_RATIO=1.0
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_OTLP_GRPC_PORT=4317

# HashiCorp Vault (dev mode — `docker compose --profile secrets up vault`)
VAULT_PORT=8200
VAULT_DEV_TOKEN=fern-dev-root
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=fern-dev-root
