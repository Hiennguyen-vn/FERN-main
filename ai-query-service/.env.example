# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
OPENAI_API_MODE=chat
OPENAI_USER_AGENT=FERN-ai-query-service/0.1
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDINGS_ENABLED=true

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=fern
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# OpenSearch
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_ALIASES_INDEX=ai_aliases
OPENSEARCH_TEMPLATES_INDEX=ai_templates

# Redis Sentinel
REDIS_SENTINEL_HOSTS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_SENTINEL_MASTER=fern-master

# Kafka
KAFKA_BOOTSTRAP=kafka:29092,kafka-2:29092,kafka-3:29092
KAFKA_AUDIT_TOPIC=fern.audit.ai-query

# Internal service auth (shared secret with Gateway)
INTERNAL_SERVICE_TOKEN=change-me-in-production

# Limits
MAX_QUESTION_LENGTH=500
MAX_ROWS_PER_QUERY=1000
QUERY_TIMEOUT_SECONDS=30
MAX_CORRECTION_ATTEMPTS=2
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=200

# Service
SERVICE_PORT=8093
LOG_LEVEL=INFO
