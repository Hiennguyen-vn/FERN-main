# OpenAI (or compatible gateway). Base URL must include /v1 (SDK appends paths under it).
# Example proxy (Responses + Chat):
# OPENAI_BASE_URL=https://llm.builtbynatsu.dev/v1
# OPENAI_API_MODE=responses
# OPENAI_RESPONSES_PREVIOUS_RESPONSE_ID_ENABLED=false
# OPENAI_MODEL=codex/gpt-5.3-codex
# OPENAI_USER_AGENT=Sketchonomy/0.1
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
OPENAI_API_MODE=chat
OPENAI_RESPONSES_PREVIOUS_RESPONSE_ID_ENABLED=true
OPENAI_USER_AGENT=FERN-ai-query-service/0.1
OPENAI_MODEL=gpt-4.1
OPENAI_MODEL_SUPERVISOR=
OPENAI_MODEL_SQL_PLANNER=
OPENAI_MODEL_SQL_GENERATOR=
OPENAI_MODEL_REVIEWER=
OPENAI_MODEL_FORMATTER=
OPENAI_MODEL_DOC_READER=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDINGS_ENABLED=true
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=fern
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Postgres read replica for controlled HR queries
POSTGRES_HOST=postgres-replica
POSTGRES_PORT=5432
POSTGRES_DB=fern
POSTGRES_USER=fern
POSTGRES_PASSWORD=fern
POSTGRES_STATEMENT_TIMEOUT_SECONDS=10

# OpenSearch
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_ALIASES_INDEX=ai_aliases
OPENSEARCH_TEMPLATES_INDEX=ai_templates
OPENSEARCH_CATALOG_INDEX=ai_catalog
OPENSEARCH_METADATA_INDEX=ai_metadata

# Redis Sentinel
REDIS_SENTINEL_HOSTS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_SENTINEL_MASTER=fern-master

# Kafka
KAFKA_BOOTSTRAP=kafka:29092,kafka-2:29092,kafka-3:29092
KAFKA_AUDIT_TOPIC=fern.audit.ai-query
KAFKA_LEARNING_TOPIC=fern.ai-query.learning.staging
LEARNING_STAGING_EMIT_ENABLED=false

# Internal service auth (shared secret with Gateway)
INTERNAL_SERVICE_TOKEN=change-me-in-production

# Limits
MAX_QUESTION_LENGTH=500
MAX_ROWS_PER_QUERY=1000
QUERY_TIMEOUT_SECONDS=30
MAX_CORRECTION_ATTEMPTS=2
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=200

# Reasoning hops (LangGraph LLM — extra latency; fail-open when disabled/errors)
QUERY_REASONING_ENABLED=true
SQL_LOGICAL_CHECK_ENABLED=true
# Accuracy-first defaults: deterministic shortcuts are opt-in latency mode.
DETERMINISTIC_SUPERVISOR_ENABLED=true
TEMPLATE_FAST_PATH_ENABLED=true

# Catalog hints for matcher/reasoner (optional ClickHouse system.columns — adds latency)
CATALOG_DIGEST_ENABLED=false
CATALOG_DIGEST_MAX_TABLES=2
CATALOG_DIGEST_MAX_COLUMNS_PER_TABLE=40
CATALOG_DIGEST_MAX_CHARS=2800
METADATA_CONTEXT_ENABLED=true
METADATA_CONTEXT_MAX_HITS=5
METADATA_CONTEXT_MAX_CHARS=2600

# SQL Writer / GenSQL orchestrator:
# verified/template/scenario first; when no safe template or low confidence, LLM writes a SELECT,
# then AST allow-list, programmatic RBAC, reviewer, trial, and readonly executor must pass.
CODEGEN_SQL_ENABLED=true
# off | low_confidence | no_template_or_low_confidence | always_try
CODEGEN_ROUTE_MODE=no_template_or_low_confidence
CODEGEN_CONFIDENCE_THRESHOLD=0.55
CODEGEN_MAX_OUTER_LIMIT=1000
MAX_CODEGEN_ATTEMPTS=2
MAX_CODEGEN_TRIAL_ROWS=50
MAX_CODEGEN_TRIAL_TIMEOUT_SECONDS=10
CODEGEN_REVIEW_ENABLED=true
CODEGEN_SQL_PLAN_ENABLED=true

# Controlled HR query lane (static Postgres allowlist + RBAC)
HR_QUERY_ENABLED=true
HR_QUERY_MAX_ROWS=50

# Finch-style simplified agent graph: Supervisor (1 LLM) + SQL Writer (Codex + tool loop) + Template Path (deterministic).
# Replaces the 21-node legacy graph. Run side-by-side via this flag while validating against golden tests.
AGENT_MODE_ENABLED=false

# SQL Writer Agent self-consistency (Wang et al. 2022 voting). 1=single shot,
# 2 doubles cost but typically lifts execution accuracy on ambiguous queries.
SQL_WRITER_SELF_CONSISTENCY_N=1

# Service
SERVICE_PORT=8093
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Ho_Chi_Minh

# CSV / JSON verification exports (same TTL; JSON is machine-readable rows + minimal meta)
EXPORTS_ENABLED=true
EXPORTS_JSON_ENABLED=true
SESSION_ENRICHER_ENABLED=true

# Long-term agent memory (pgvector). Off by default until the V78 migration runs.
AGENT_KB_ENABLED=false
AGENT_KB_TOP_K=3
AGENT_KB_MIN_SIMILARITY=0.78
AGENT_KB_MAX_SUMMARY_CHARS=600
AGENT_KB_MAX_PER_USER=200
AGENT_KB_EMBED_DIM=1536
AGENT_KB_TABLE=ai.agent_knowledge_base

# When true (or HTTP header X-FERN-AI-Workflow-Debug: 1), POST /query includes workflow_summary + workflow_trace
WORKFLOW_DEBUG_IN_RESPONSE=false
