rectangle "FERN ERP Platform" <<Group-RkVSTiBFUlAgUGxhdGZvcm0=>> as group1 {
  rectangle "==Master Control Plane\n<size:16>[Software System]</size>\n\nService registry, heartbeat, service discovery, config distribution, feature flags, rollout metadata và health aggregation." <<Element-RWxlbWVudCxQbGF0Zm9ybSBTeXN0ZW0=>> as MasterControlPlane
  rectangle "==Organization Reference System\n<size:16>[Software System]</size>\n\nCurrency, region, outlet và organizational reference data." <<Element-RWxlbWVudCxCdXNpbmVzcyBTeXN0ZW0=>> as OrganizationReferenceSystem
  rectangle "==Product / Catalog / Pricing System\n<size:16>[Software System]</size>\n\nProduct categories, items, products, allergens, modifier groups, recipes, product availability, tax và outlet pricing." <<Element-RWxlbWVudCxCdXNpbmVzcyBTeXN0ZW0=>> as ProductCatalogPricingSystem
  rectangle "==Procurement System\n<size:16>[Software System]</size>\n\nSupplier, purchase order, goods receipt, supplier invoice, supplier payment và payment allocation workflows." <<Element-RWxlbWVudCxCdXNpbmVzcyBTeXN0ZW0=>> as ProcurementSystem
  rectangle "==Sales / POS / CRM System\n<size:16>[Software System]</size>\n\nPOS sessions, sale records, payments, promotions, customer ordering, CRM/loyalty, sync-facing sales workflows và telemetry routing." <<Element-RWxlbWVudCxCdXNpbmVzcyBTeXN0ZW0=>> as SalesPOSCRMSystem
  rectangle "==Sync System\n<size:16>[Software System]</size>\n\nDevice sync service cho edge/POS synchronization và central sync endpoints." <<Element-RWxlbWVudCxCdXNpbmVzcyBTeXN0ZW0=>> as SyncSystem
  rectangle "==Inventory System\n<size:16>[Software System]</size>\n\nInventory transactions, stock count, waste, goods receipt transactions, manufacturing batches và stock projections." <<Element-RWxlbWVudCxCdXNpbmVzcyBTeXN0ZW0=>> as InventorySystem
  rectangle "==HR System\n<size:16>[Software System]</size>\n\nShift, work shift và employee contract workflows." <<Element-RWxlbWVudCxCdXNpbmVzcyBTeXN0ZW0=>> as HRSystem
  rectangle "==Payroll System\n<size:16>[Software System]</size>\n\nPayroll periods, timesheets, payroll generation, approval và payroll expense handoff." <<Element-RWxlbWVudCxCdXNpbmVzcyBTeXN0ZW0=>> as PayrollSystem
  rectangle "==Finance System\n<size:16>[Software System]</size>\n\nExpense records, purchase/payroll/operating/other expenses và finance document workflows." <<Element-RWxlbWVudCxCdXNpbmVzcyBTeXN0ZW0=>> as FinanceSystem
  rectangle "==Audit System\n<size:16>[Software System]</size>\n\nAudit log persistence và audit-event consumption for traceability." <<Element-RWxlbWVudCxCdXNpbmVzcyBTeXN0ZW0=>> as AuditSystem
  rectangle "==Reporting System\n<size:16>[Software System]</size>\n\nRead-only reporting and aggregate views. Reads from PostgreSQL replica, not primary writes." <<Element-RWxlbWVudCxJbnNpZ2h0IFN5c3RlbQ==>> as ReportingSystem
  rectangle "==AI Query System\n<size:16>[Software System]</size>\n\nNatural-language BI/query sidecar with guarded SQL, outlet-scope/RBAC injection, ClickHouse/OpenSearch integrations and LLM calls." <<Element-RWxlbWVudCxJbnNpZ2h0IFN5c3RlbQ==>> as AIQuerySystem
  rectangle "==Local Data Simulator\n<size:16>[Software System]</size>\n\nLocal-only operational data simulator with preview/execute guardrails." <<Element-RWxlbWVudCxUb29sIFN5c3RlbQ==>> as LocalDataSimulator
  rectangle "==Frontend Web Application\n<size:16>[Software System]</size>\n\nReact/Vite workspace cho admin, POS staff, analyst và customer ordering. Frontend gọi gateway, không gọi trực tiếp service nội bộ." <<Element-RWxlbWVudCxGcm9udGVuZA==>> as FrontendWebApplication
  rectangle "==API Gateway\n<size:16>[Software System]</size>\n\nSpring Cloud Gateway ingress: route catalog, auth/session handling, rate limiting, circuit breaker, header propagation và public/internal route boundary." <<Element-RWxlbWVudCxQbGF0Zm9ybSBTeXN0ZW0=>> as APIGateway
  rectangle "==Auth / IAM System\n<size:16>[Software System]</size>\n\nLogin, refresh/session, user, role, permission, device pairing và outlet-scoped authorization context." <<Element-RWxlbWVudCxCdXNpbmVzcyBTeXN0ZW0=>> as AuthIAMSystem
}

rectangle "Shared Data and Infrastructure" <<Group-U2hhcmVkIERhdGEgYW5kIEluZnJhc3RydWN0dXJl>> as group2 {
  database "==PostgreSQL Primary\n<size:16>[Software System]</size>\n\nShared fern database / core schema. Primary write store shared by FERN systems; not database-per-service." <<Element-RWxlbWVudCxEYXRhYmFzZSBTeXN0ZW0=>> as PostgreSQLPrimary
  database "==PostgreSQL Read Replica\n<size:16>[Software System]</size>\n\nStreaming standby database for reporting/read-only workloads." <<Element-RWxlbWVudCxEYXRhYmFzZSBTeXN0ZW0=>> as PostgreSQLReadReplica
  rectangle "==PgBouncer / HAProxy Pool\n<size:16>[Software System]</size>\n\nOptional pooled database access path for PostgreSQL primary." <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBTeXN0ZW0=>> as PgBouncerHAProxyPool
  rectangle "==Redis + Sentinel\n<size:16>[Software System]</size>\n\nCache, sessions, rate limits, heartbeat registry, hot config and failover-capable Redis topology." <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBTeXN0ZW0=>> as RedisSentinel
  rectangle "==Kafka KRaft\n<size:16>[Software System]</size>\n\nEvent backbone for domain events, audit events, async integration and CDC." <<Element-RWxlbWVudCxNZXNzYWdlIFN5c3RlbQ==>> as KafkaKRaft
  rectangle "==Kafka Connect / Debezium\n<size:16>[Software System]</size>\n\nCDC pipeline from PostgreSQL into Kafka and analytics targets." <<Element-RWxlbWVudCxNZXNzYWdlIFN5c3RlbQ==>> as KafkaConnectDebezium
  rectangle "==S3-compatible Object Storage\n<size:16>[Software System]</size>\n\nMinIO local or external S3-compatible buckets for product images and finance documents." <<Element-RWxlbWVudCxFeHRlcm5hbCBTeXN0ZW0=>> as S3compatibleObjectStorage
  database "==ClickHouse Analytics Store\n<size:16>[Software System]</size>\n\nAnalytics/CDC store for AI Query and analytical projections." <<Element-RWxlbWVudCxBbmFseXRpY3MgU3lzdGVt>> as ClickHouseAnalyticsStore
  rectangle "==OpenSearch\n<size:16>[Software System]</size>\n\nSearch/RAG/runtime catalog indexes for AI Query." <<Element-RWxlbWVudCxTZWFyY2ggU3lzdGVt>> as OpenSearch
  rectangle "==Observability Stack\n<size:16>[Software System]</size>\n\nPrometheus, Grafana, Jaeger and exporters for health, metrics and traces." <<Element-RWxlbWVudCxPYnNlcnZhYmlsaXR5IFN5c3RlbQ==>> as ObservabilityStack
  rectangle "==Vault / Secrets Provider\n<size:16>[Software System]</size>\n\nOptional secret/config source for service credentials." <<Element-RWxlbWVudCxFeHRlcm5hbCBTeXN0ZW0=>> as VaultSecretsProvider
}

person "==Back-office Admin\n<size:16>[Person]</size>\n\nQuản trị chuỗi: danh mục, mua hàng, kho, nhân sự, lương, tài chính, báo cáo và cấu hình vận hành." <<Element-RWxlbWVudCxQZXJzb24=>> as BackofficeAdmin
person "==Outlet / POS Staff\n<size:16>[Person]</size>\n\nNhân viên cửa hàng vận hành ca bán, đơn hàng, thanh toán, đồng bộ thiết bị và xử lý tồn kho." <<Element-RWxlbWVudCxQZXJzb24=>> as OutletPOSStaff
person "==Customer\n<size:16>[Person]</size>\n\nKhách hàng đặt món qua QR/table ordering." <<Element-RWxlbWVudCxQZXJzb24=>> as Customer
rectangle "==OpenAI-compatible LLM Provider\n<size:16>[Software System]</size>\n\nExternal model provider used by AI Query." <<Element-RWxlbWVudCxFeHRlcm5hbCBTeXN0ZW0=>> as OpenAIcompatibleLLMProvider
person "==Business Analyst\n<size:16>[Person]</size>\n\nNgười dùng khai thác báo cáo, dashboard và đặt câu hỏi dữ liệu bằng ngôn ngữ tự nhiên." <<Element-RWxlbWVudCxQZXJzb24=>> as BusinessAnalyst
person "==System Operator\n<size:16>[Person]</size>\n\nNgười vận hành theo dõi health, metrics, traces, service registry và dữ liệu demo." <<Element-RWxlbWVudCxQZXJzb24=>> as SystemOperator
person "==Developer / QA\n<size:16>[Person]</size>\n\nKỹ sư phát triển, kiểm thử, chạy local services, migrations, simulator và smoke tests." <<Element-RWxlbWVudCxQZXJzb24=>> as DeveloperQA

