  <packaging>pom</packaging>

  <name>FERN Backend</name>
  <description>Multi-module Maven backend starter aligned to a microservices architecture.</description>

  <modules>
    <module>common</module>
    <module>gateway</module>
    <module>services</module>
    <module>tools</module>
